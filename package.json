{
  "name": "permask",
  "version": "3.0.1",
  "type": "module",
  "description": "A lightweight utility library for managing permission bitmasks with groups and access levels",
  "workspaces": [
    "playground/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/integrations/*/index.d.ts",
      "import": "./dist/integrations/*/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "bunx --bun vite build",
    "check": "bun run lint && bun run typecheck && bun run test -- --run && bun run build",
    "test": "bunx --bun vitest",
    "test:coverage": "bunx --bun vitest run --coverage",
    "typecheck": "bun --bun tsrs --checkers 2 -p tsconfig.json --noEmit",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bun run lint -- --write",
    "prepare": "bunx --bun is-ci || bunx --bun husky",
    "husky:pre-commit": "bun run lint",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nkzw/oxlint-config": "3.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "elysia": "^1.4.32",
    "fastify": "^5.12.8",
    "h3": "^1.15.11",
    "hono": "^4.13.19",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "itty-router": "^5.0.24",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "reflect-metadata": "^0.2.2",
    "semantic-release": "^25.0.9",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@types/express": "^4.17.0 || ^5.0.0",
    "@types/koa": "^2.0.0 || ^3.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "elysia": "^1.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "h3": "^1.0.0 || ^2.0.0-0",
    "hono": "^4.0.0",
    "itty-router": "^5.0.0",
    "koa": "^2.0.0",
    "nitropack": "^2.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "@types/koa": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "itty-router": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "nitropack": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "files": [
    "dist/*",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "bitmask",
    "access",
    "permissions",
    "authorization",
    "auth",
    "hono",
    "nest",
    "express",
    "itty-router"
  ],
  "author": "dschewchenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dschewchenko/permask/issues"
  },
  "homepage": "https://github.com/dschewchenko/permask#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dschewchenko/permask.git"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ],
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "provenance": true
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1",
    "@sigstore/core": "3.2.1",
    "ajv": "8.20.0",
    "brace-expansion": "2.1.7",
    "diff": "8.0.4",
    "fast-uri": "3.1.9",
    "handlebars": "4.7.10",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "11.0.1",
    "pacote": "21.5.1",
    "picomatch": "2.3.2",
    "rollup": "4.62.2",
    "sigstore": "4.1.1",
    "tar": "7.5.21",
    "undici": "7.30.1"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.0.0"
  }
}
